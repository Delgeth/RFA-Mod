<ui:FluentWindow xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="RfaEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RfaEditor"
        xmlns:dock="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:layout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        Title="RFA Editor" Width="1600" Height="950" MinWidth="1000" MinHeight="600"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        SourceInitialized="OnSourceInitialized" Activated="OnActivated" Closing="OnClosing">
    <DockPanel>
        <!-- Top bar: the editor's name, where the game and your changes are -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="10,5">
            <DockPanel x:Name="TopBar">
                <TextBlock Text="{x:Static local:Icons.Model}" Style="{StaticResource Icon}" FontSize="16"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                <TextBlock Text="RFA Editor" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0" />
                <Button DockPanel.Dock="Right" Click="OnOpenOverridesFolder" Margin="0"
                        ToolTip="Where your changes are saved (the game's own files are never changed)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static local:Icons.OpenFolder}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Overrides folder" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Click="OnOpenGameLevel" Margin="0,0,8,0"
                        ToolTip="Opens the zone the running game has loaded (the one its camera is in), in the level editor">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static local:Icons.Zone}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Game's level" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Click="OnSpawnResources" Margin="0,0,8,0"
                        ToolTip="What a level can spawn (its characters, vehicles, exos, the player's look): its spawn_resource.xtbl entry, changed or added to">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static local:Icons.Spawn}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Spawn resources" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Click="OnDeleteLevel" Margin="0,0,8,0"
                        ToolTip="Deletes a level made with New level, all of it: from its map list, its spawn resources, strings and pictures, and its archive with its edits">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static local:Icons.Delete}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Delete level" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Click="OnNewLevel" Margin="0,0,8,0"
                        ToolTip="Makes a brand-new level for Ruin or Infestation, listed in that mode's map list, with its own preview picture">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static local:Icons.Add}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="New level" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Click="OnShowGame" Margin="0,0,8,0"
                        ToolTip="Shows the Game panel: the running game, docked in the editor">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static local:Icons.Game}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Game" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="GameFolderText" Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Padding="6,0">
            <TextBlock x:Name="StatusText" />
        </StatusBar>

        <!-- Every panel can be dragged by its title to dock it elsewhere, floated, or pinned to a side
             (AvalonDock). The documents (preview, tables, levels) are the tabs in the middle. -->
        <dock:DockingManager x:Name="DockManager" AllowMixedOrientation="True" Background="{StaticResource WindowBrush}">
            <layout:LayoutRoot>
                <layout:LayoutPanel Orientation="Vertical">
                    <layout:LayoutPanel Orientation="Horizontal">
                        <layout:LayoutAnchorablePane DockWidth="300" DockMinWidth="180">
                            <layout:LayoutAnchorable ContentId="explorer" Title="Explorer" CanClose="False" CanHide="False">
                                <DockPanel Background="{StaticResource PanelBrush}">
                            <Grid DockPanel.Dock="Top" Margin="8,8,8,6">
                                <TextBox x:Name="SearchBox" Padding="26,4,4,4" TextChanged="OnSearchChanged"
                                         ToolTip="Find files by name in every archive and container" />
                                <TextBlock Text="{x:Static local:Icons.Search}" Style="{StaticResource Icon}" FontSize="12"
                                           HorizontalAlignment="Left" Margin="9,0,0,0" Foreground="{StaticResource DimTextBrush}" IsHitTestVisible="False" />
                                <TextBlock x:Name="SearchHint" Text="Search every file" Style="{StaticResource HintText}" Margin="31,0,0,0" />
                            </Grid>
                            <Grid>
                                <TreeView x:Name="Tree" SelectedItemChanged="OnTreeSelectionChanged"
                                          TreeViewItem.Expanded="OnTreeItemExpanded" MouseDoubleClick="OnFileDoubleClick">
                                    <TreeView.ItemTemplate>
                                        <!-- A row: the icon of its kind of file, its name, a note, and a mark if you changed it -->
                                        <HierarchicalDataTemplate DataType="{x:Type local:TreeNode}" ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Kind.Icon}" Foreground="{Binding Kind.Colour}" Style="{StaticResource Icon}"
                                                           FontSize="13" Width="16" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Note}" Foreground="{StaticResource DimTextBrush}" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" FontSize="11" />
                                                <Border x:Name="ChangedMark" Background="{StaticResource ChangedBrush}" CornerRadius="7" Padding="6,0"
                                                        Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                                        ToolTip="You changed this file: the game uses your copy in overrides\">
                                                    <TextBlock Text="changed" FontSize="10" FontWeight="SemiBold" Foreground="#1B1C1F" />
                                                </Border>
                                            </StackPanel>
                                            <HierarchicalDataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Changed}" Value="True">
                                                    <Setter TargetName="ChangedMark" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </HierarchicalDataTemplate.Triggers>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                                <ListBox x:Name="SearchResults" Visibility="Collapsed" SelectionChanged="OnSearchSelectionChanged"
                                         MouseDoubleClick="OnFileDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <!-- A found file: its icon and name, and under it where it is -->
                                        <DataTemplate DataType="{x:Type local:IndexedFile}">
                                            <DockPanel Margin="0,2">
                                                <TextBlock Text="{Binding Kind.Icon}" Foreground="{Binding Kind.Colour}" Style="{StaticResource Icon}"
                                                           FontSize="13" Width="16" Margin="0,0,8,0" VerticalAlignment="Top" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Where}" Foreground="{StaticResource DimTextBrush}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                                </DockPanel>
                            </layout:LayoutAnchorable>
                        </layout:LayoutAnchorablePane>

                        <!-- The documents, and the running game as a tab among them (see Documents\GamePanel.cs): drag
                             its tab to a side to see it next to a level. It can't be pinned to a side: the game's
                             own window can't slide in and out with it. -->
                        <layout:LayoutDocumentPane x:Name="DocumentPane">
                            <layout:LayoutAnchorable x:Name="GameAnchorable" ContentId="game" Title="Game" CanClose="False"
                                                     CanHide="False" CanAutoHide="False">
                                <ContentControl x:Name="GameHostPanel" />
                            </layout:LayoutAnchorable>
                        </layout:LayoutDocumentPane>

                        <layout:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="380" DockMinWidth="220">
                            <layout:LayoutAnchorablePane DockHeight="*">
                                <layout:LayoutAnchorable ContentId="outliner" Title="Outliner" CanClose="False" CanHide="False">
                                    <ContentControl x:Name="OutlinerHost" Background="{StaticResource PanelBrush}" />
                                </layout:LayoutAnchorable>
                            </layout:LayoutAnchorablePane>
                            <layout:LayoutAnchorablePane DockHeight="1.3*">
                                <layout:LayoutAnchorable ContentId="inspector" Title="Inspector" CanClose="False" CanHide="False">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Background="{StaticResource PanelBrush}">
                                        <ContentControl x:Name="InspectorHost" />
                                    </ScrollViewer>
                                </layout:LayoutAnchorable>
                            </layout:LayoutAnchorablePane>
                        </layout:LayoutAnchorablePaneGroup>
                    </layout:LayoutPanel>

                    <layout:LayoutAnchorablePane DockHeight="150" DockMinHeight="40">
                        <layout:LayoutAnchorable ContentId="log" Title="Log" CanClose="False" CanHide="False">
                            <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:LogLine}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource DimTextBrush}" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Text}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </layout:LayoutAnchorable>
                    </layout:LayoutAnchorablePane>
                </layout:LayoutPanel>
            </layout:LayoutRoot>
        </dock:DockingManager>
    </DockPanel>
</ui:FluentWindow>
