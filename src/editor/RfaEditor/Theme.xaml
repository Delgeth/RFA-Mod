<!--
    The editor's look: Fluent, dark, from WPF UI, which is loaded before this (see App.xaml; the
    Guerrilla builder loads it the same way). Every control is WPF UI's. This file adds:
    - the editor's own names for colours (the code and every window use them), on Fluent's dark ones;
    - WPF UI's controls a little tighter, as an editor's rows of fields and long lists want them;
    - a few looks WPF UI has no control for: icon-only tool buttons, the accent-filled main button,
      chips, a tool's options box, a panel's title bar, headings.

    Icons are characters of the Fluent System Icons font that comes inside WPF UI (so they show on
    any PC, Linux under Wine too); Icons.cs names the ones used.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- ==== Colours ============================================================================ -->

    <!-- Fluent's dark layers: the window, the panels on it, a panel's header, controls on a panel -->
    <SolidColorBrush x:Key="WindowBrush" Color="#202020" />
    <SolidColorBrush x:Key="PanelBrush" Color="#272727" />
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="ControlBrush" Color="#323232" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#2F2F2F" />
    <SolidColorBrush x:Key="InputBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="BorderBrush" Color="#363636" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DimTextBrush" Color="#9D9D9D" />

    <!-- See-through fills for things that sit on anything (Fluent's "subtle" fills) -->
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#383838" />

    <!-- The accent: Fluent's blue as a dark look shows it, the same as WPF UI's controls have (see
         FluentLook.UseEditorAccent), with the text that goes on it -->
    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#57B9E6" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#000000" />

    <SolidColorBrush x:Key="ChangedBrush" Color="#E5A445" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="AxisXBrush" Color="#E64646" />
    <SolidColorBrush x:Key="AxisYBrush" Color="#50D25A" />
    <SolidColorBrush x:Key="AxisZBrush" Color="#4682FF" />
    <SolidColorBrush x:Key="LevelGeometryBrush" Color="#B39A7C" />
    <SolidColorBrush x:Key="TerrainBrush" Color="#C9B27E" />
    <SolidColorBrush x:Key="DecalBrush" Color="#9C8FB5" />
    <SolidColorBrush x:Key="FoliageBrush" Color="#8FA36B" />
    <SolidColorBrush x:Key="RelatedBrush" Color="#E07A9B" />
    <SolidColorBrush x:Key="NeighbourBrush" Color="#7C8AA6" />
    <SolidColorBrush x:Key="LinkBrush" Color="#FFC440" />

    <!-- The 3D views: lighter at the top, like a sky -->
    <LinearGradientBrush x:Key="ViewportBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#343944" Offset="0" />
        <GradientStop Color="#1C1E23" Offset="1" />
    </LinearGradientBrush>

    <!-- Selected items in lists drawn by the code, and the corner between two scroll bars -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#383838" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#323232" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#272727" />

    <!-- ==== Text =============================================================================== -->

    <!-- Text in WPF UI's controls the size of the editor's own, which is smaller than Fluent's 14 -->
    <system:Double x:Key="ControlContentThemeFontSize">12</system:Double>
    <system:Double x:Key="TextControlThemeMinHeight">24</system:Double>

    <FontFamily x:Key="IconFont">pack://application:,,,/Wpf.Ui;component/Resources/Fonts/#FluentSystemIcons-Regular</FontFamily>

    <!-- An icon: one character of the icon font -->
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- A panel's title bar, e.g. "EXPLORER" -->
    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The bar a panel's title sits in -->
    <Style x:Key="PanelHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelHeaderBrush}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0,6,0" />
    </Style>

    <!-- The small icon in front of a panel's title -->
    <Style x:Key="PanelIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- Grey hint text, e.g. in an empty search box -->
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- A heading inside a panel, e.g. "TRANSFORM" in the inspector -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,14,0,6" />
    </Style>

    <!-- A thin upright line between groups of tool buttons -->
    <Style x:Key="ToolbarSeparator" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Fill" Value="{StaticResource BorderBrush}" />
    </Style>

    <!-- The eye at the end of a row of the Scene panel: open while what the row stands for is drawn,
         closed (and dim) while it isn't -->
    <Style x:Key="EyeToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="6,0,2,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTip" Value="Drawn in the view, or not" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Box" Background="Transparent" CornerRadius="4">
                        <TextBlock x:Name="Glyph" Text="&#xE5F5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE5F2;" />
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource SubtleHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small window of a tool's own options over a view (the sculptor's brush, ...) -->
    <Style x:Key="OptionsCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8,12,10" />
        <Setter Property="Margin" Value="10" />
    </Style>

    <!-- ==== Buttons ============================================================================ -->

    <!-- A button, a little apart from the next one -->
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- The main thing to do in a place, e.g. "Save": filled with the accent colour -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="11,5,11,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource ControlBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small square button showing only an icon (undo, focus, ...): WPF UI's button with no box
         until the mouse is over it; its tool tip says what it does -->
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="1,0" />
    </Style>

    <!-- A row of a list that does something when clicked (the inspector's links): flat, lit under the mouse -->
    <Style x:Key="ListRow" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="Transparent" CornerRadius="4" Padding="4,2">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource SubtleHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource SubtlePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An on/off button (the select/move/rotate tools, snapping, ...): WPF UI's, filled with the
         accent while on, with no box while off until the mouse is over it -->
    <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Margin" Value="1,0" />
    </Style>

    <!-- A rounded on/off label, e.g. a kind of object to show in the level view -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Box" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="11" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource ControlBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DimTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== Fields, lists and the rest: WPF UI's, tighter ======================================== -->

    <!-- A text box. A red border set for a wrong value still shows: WPF UI's text box draws the
         border it is given -->
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="Padding" Value="8,4,8,4" />
    </Style>

    <!-- A check box, without the room Fluent leaves round it (rows of flags sit close) -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="6,0,0,0" />
    </Style>

    <Style TargetType="TreeView" BasedOn="{StaticResource DefaultTreeViewStyle}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style TargetType="TreeViewItem" BasedOn="{StaticResource DefaultTreeViewItemStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style TargetType="ListBox" BasedOn="{StaticResource DefaultListBoxStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <!-- A tool tip, wide enough for the editor's longer explanations -->
    <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}">
        <Setter Property="MaxWidth" Value="420" />
    </Style>

    <!-- The status line at the window's foot: one line of dim text on the window itself (Mica, on
         Windows 11), without WPF UI's box round it -->
    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource WindowBrush}" />
    </Style>
</ResourceDictionary>
