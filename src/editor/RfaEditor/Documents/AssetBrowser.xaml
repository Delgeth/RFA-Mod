<UserControl x:Class="RfaEditor.AssetBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RfaEditor"
             Background="{StaticResource PanelBrush}">
    <!-- The Assets panel: where things to add to the zone come from, on the left; what is there, in
         the middle, narrowed by Find; the picked one in 3D on the right. Double-click one, or drag it
         into the view, to add it. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="140" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" MinWidth="200" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="260" MinWidth="140" />
        </Grid.ColumnDefinitions>

        <TreeView x:Name="Sources" Grid.Column="0" SelectedItemChanged="OnSourceChosen"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" Width="1" />

        <DockPanel Grid.Column="2">
            <Grid DockPanel.Dock="Top" Margin="8,6,8,6">
                <TextBox x:Name="FindBox" Padding="28,4,4,4" TextChanged="OnFindChanged"
                         ToolTip="Find by name, in what is chosen on the left (or in everything, if nothing is)" />
                <TextBlock Text="{x:Static local:Icons.Search}" Style="{StaticResource Icon}" FontSize="14" HorizontalAlignment="Left"
                           Margin="9,0,0,0" Foreground="{StaticResource DimTextBrush}" IsHitTestVisible="False" />
                <TextBlock x:Name="FindHint" Text="Find" Style="{StaticResource HintText}" Margin="31,0,0,0" />
            </Grid>
            <TextBlock x:Name="ListNote" DockPanel.Dock="Bottom" Margin="10,2,8,4" FontSize="11" Foreground="{StaticResource DimTextBrush}"
                       TextTrimming="CharacterEllipsis" />
            <ListBox x:Name="Items" SelectionChanged="OnItemChosen" MouseDoubleClick="OnItemDoubleClick" KeyDown="OnItemKey"
                     PreviewMouseLeftButtonDown="OnItemPressed" PreviewMouseMove="OnItemDragged"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel ToolTip="{Binding Tip}" Background="Transparent" Margin="0,0,14,0"> <!-- (room for the scroll bar, drawn over the rows) -->
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Foreground="{Binding Colour}" Style="{StaticResource Icon}"
                                       FontSize="13" Width="18" Margin="0,0,6,0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{StaticResource DimTextBrush}" FontSize="11"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                <Run Text="{Binding Name, Mode=OneWay}" />
                                <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource DimTextBrush}" FontSize="11" />
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" Width="1" />

        <!-- The picked one: its model in 3D (drag to turn it, wheel to come closer), or its kind's icon -->
        <DockPanel Grid.Column="4">
            <StackPanel DockPanel.Dock="Bottom" Margin="10,4,10,6">
                <TextBlock x:Name="PreviewTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PreviewInfo" FontSize="11" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" MaxHeight="48"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border x:Name="PreviewArea" Background="{StaticResource ViewportBrush}" ClipToBounds="True" Cursor="SizeAll" Margin="6,6,6,0" CornerRadius="6">
                <Grid>
                    <Viewport3D x:Name="PreviewViewport" />
                    <TextBlock x:Name="PreviewIcon" Style="{StaticResource Icon}" FontSize="56" Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
