<UserControl x:Class="RfaEditor.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="clr-namespace:AvalonDock;assembly=AvalonDock"
             xmlns:layout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock">
    <!-- Where the panels start. Each is named by its ContentId; the code gives it its title and view
         (see the list of panels in MainPage.xaml.cs). What you open (the preview, tables, zones) are
         the tabs in the middle. -->
    <dock:DockingManager x:Name="DockManager" AllowMixedOrientation="True" Background="{StaticResource WindowBrush}">
        <layout:LayoutRoot>
            <layout:LayoutPanel Orientation="Horizontal">
                <layout:LayoutAnchorablePane DockWidth="300" DockMinWidth="180">
                    <layout:LayoutAnchorable ContentId="explorer" />
                </layout:LayoutAnchorablePane>
                <layout:LayoutPanel Orientation="Vertical">
                    <layout:LayoutDocumentPane />
                    <layout:LayoutAnchorablePane DockHeight="230" DockMinHeight="40">
                        <layout:LayoutAnchorable ContentId="assets" />
                        <layout:LayoutAnchorable ContentId="log" />
                    </layout:LayoutAnchorablePane>
                </layout:LayoutPanel>
                <layout:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="360" DockMinWidth="220">
                    <layout:LayoutAnchorablePane DockHeight="*">
                        <layout:LayoutAnchorable ContentId="outliner" />
                    </layout:LayoutAnchorablePane>
                    <layout:LayoutAnchorablePane DockHeight="1.3*">
                        <layout:LayoutAnchorable ContentId="inspector" />
                    </layout:LayoutAnchorablePane>
                </layout:LayoutAnchorablePaneGroup>
            </layout:LayoutPanel>
        </layout:LayoutRoot>
    </dock:DockingManager>
</UserControl>
