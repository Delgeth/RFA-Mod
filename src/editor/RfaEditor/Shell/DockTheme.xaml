<!--
    The docking panels' look (see DockTheme.cs): AvalonDock's dark theme, with its colours set to the
    editor's Fluent ones (Theme.xaml), so the panels, their tabs and their floating windows look like
    the rest of the window. Only colours change here; the theme's own shapes stay.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:keys="clr-namespace:AvalonDock.Themes.VS2013.Themes;assembly=AvalonDock.Themes.VS2013">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AvalonDock.Themes.VS2013;component/DarkTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Behind and between the panels, and their edges -->
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.Background}" Color="#202020" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.PanelBorderBrush}" Color="#333333" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.TabBackground}" Color="#202020" />

    <!-- A panel's title: the one you are working in a shade lighter -->
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowCaptionActiveBackground}" Color="#323232" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowCaptionActiveText}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowCaptionActiveGrip}" Color="#323232" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowCaptionInactiveBackground}" Color="#2C2C2C" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowCaptionInactiveText}" Color="#9D9D9D" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowCaptionInactiveGrip}" Color="#2C2C2C" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowCaptionButtonActiveGlyph}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowCaptionButtonInactiveGlyph}" Color="#9D9D9D" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowCaptionButtonActiveHoveredBackground}" Color="#3A3A3A" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowCaptionButtonActiveHoveredBorder}" Color="#3A3A3A" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowCaptionButtonInactiveHoveredBackground}" Color="#3A3A3A" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowCaptionButtonInactiveHoveredBorder}" Color="#3A3A3A" />

    <!-- Tabs of panels stacked together -->
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowTabSelectedActiveBackground}" Color="#272727" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowTabSelectedActiveText}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowTabSelectedInactiveBackground}" Color="#272727" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowTabSelectedInactiveText}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowTabUnselectedBackground}" Color="#202020" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowTabUnselectedText}" Color="#9D9D9D" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowTabUnselectedHoveredBackground}" Color="#2F2F2F" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowTabUnselectedHoveredText}" Color="#FFFFFF" />

    <!-- The documents' tabs (zones, ...): the chosen one on the panels' colour, as Fluent's tabs -->
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabSelectedActiveBackground}" Color="#323232" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabSelectedActiveText}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabSelectedInactiveBackground}" Color="#2C2C2C" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabSelectedInactiveText}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabUnselectedBackground}" Color="#202020" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabUnselectedText}" Color="#9D9D9D" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabUnselectedHoveredBackground}" Color="#2F2F2F" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabUnselectedHoveredText}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabButtonSelectedActiveGlyph}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabButtonSelectedInactiveGlyph}" Color="#9D9D9D" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabButtonSelectedActiveHoveredBackground}" Color="#3A3A3A" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabButtonSelectedActiveHoveredBorder}" Color="#3A3A3A" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabButtonSelectedInactiveHoveredBackground}" Color="#3A3A3A" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabButtonSelectedInactiveHoveredBorder}" Color="#3A3A3A" />

    <!-- Panels and documents floated as windows of their own -->
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.FloatingDocumentWindowBackground}" Color="#202020" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.FloatingDocumentWindowBorder}" Color="#333333" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.FloatingToolWindowBackground}" Color="#202020" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.FloatingToolWindowBorder}" Color="#333333" />

    <!-- Panels pinned to a side: their tabs along the edge -->
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.AutoHideTabDefaultBackground}" Color="#202020" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.AutoHideTabDefaultBorder}" Color="#333333" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.AutoHideTabDefaultText}" Color="#9D9D9D" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.AutoHideTabHoveredBackground}" Color="#2F2F2F" />
</ResourceDictionary>
