<!--
    The builder's window: where the two games are, what to build (each part with what it is and
    whether it's built), Build and Remove, and what the build says as it goes.
-->
<Window x:Class="GuerrillaBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guerrilla Builder · RFA-Mod" Width="800" Height="830" MinWidth="620" MinHeight="600"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,4,14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FolderNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Guerrilla Builder" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Makes Red Faction: Guerrilla's world, HUD, vehicles, weapons and people usable in Armageddon, from your own copy of Guerrilla. Neither game's folder is changed: everything goes into this RFA-Mod folder." />
        </StackPanel>

        <!-- Where the two games are -->
        <Border Grid.Row="1" Style="{StaticResource Panel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="3" Text="FOLDERS" Style="{StaticResource SectionTitle}" Margin="0,10,0,8" />

                <TextBlock Grid.Row="1" Text="Red Faction: Guerrilla" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="GuerrillaBox" VerticalContentAlignment="Center" LostKeyboardFocus="OnGuerrillaTyped" />
                <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Margin="6,0,0,0" Click="OnBrowseGuerrilla" />
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="GuerrillaNote" Style="{StaticResource FolderNote}" />

                <TextBlock Grid.Row="3" Text="Red Faction: Armageddon" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="GameBox" VerticalContentAlignment="Center" LostKeyboardFocus="OnGameTyped" />
                <Button Grid.Row="3" Grid.Column="2" Content="Browse..." Margin="6,0,0,0" Click="OnBrowseGame" />
                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="GameNote" Style="{StaticResource FolderNote}" Margin="0,4,0,0" />
            </Grid>
        </Border>

        <!-- What to build: a row a part, made in MainWindow.xaml.cs -->
        <Border Grid.Row="2" Style="{StaticResource Panel}">
            <StackPanel>
                <TextBlock Text="WHAT TO BUILD" Style="{StaticResource SectionTitle}" Margin="0,10,0,4" />
                <StackPanel x:Name="PartRows" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,0,0,12" LastChildFill="False">
            <Button x:Name="BuildButton" Content="Build" Style="{StaticResource PrimaryButton}" Padding="22,6" Click="OnBuild"
                    ToolTip="Builds the parts ticked, in order, with any they need that aren't built yet" />
            <Button x:Name="RemoveButton" Content="Remove..." Padding="14,6" Click="OnRemove"
                    ToolTip="Takes the parts ticked away again, with the parts built on them" />
            <Button x:Name="LogButton" Content="Open the log" Padding="14,6" Margin="0" DockPanel.Dock="Right" Click="OnOpenLog"
                    ToolTip="Opens logs\guerrilla_builder.log: what the last build or removal said, with the details of any error" />
        </DockPanel>

        <TextBox Grid.Row="4" x:Name="LogBox" IsReadOnly="True" IsReadOnlyCaretVisible="False" AcceptsReturn="True"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="8,6"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" />

        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Hidden" Margin="0,0,0,8" />
            <TextBlock x:Name="StatusText" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
