<Project Sdk="Microsoft.NET.Sdk">

  <!-- GuerrillaArsenal.exe: makes Red Faction: Guerrilla's vehicles usable in Armageddon, from your own
       copy of Guerrilla, for the guerrilla_world mod. Built into bin\editor\ by build.cmd. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GuerrillaArsenal</RootNamespace>
    <AssemblyName>GuerrillaArsenal</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RfaFormats\RfaFormats.csproj" />
  </ItemGroup>

</Project>
